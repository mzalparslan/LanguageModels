{
  "problemMatcher": [
    {
      "owner": "compiler-errors",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|fatal error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
